# Allowlist: this repo lives in a home folder, so ignore everything at the top
# level except the project itself.
/*
!/.github/
!/.gitignore
!/README.md
!/capacitor.config.json
!/docs/
!/e2e/
!/native/
!/package.json
!/playwright.config.ts
!/scripts/
!/src/
!/test/
!/tsconfig.json

# Inside the project
node_modules/
test-results/
playwright-report/
e2e/__shots__/
*.jks
*.keystore
