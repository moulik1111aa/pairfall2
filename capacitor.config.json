{
  "appId": "com.pairfall.game",
  "appName": "Pairfall",
  "webDir": "www",
  "backgroundColor": "#D9E4DC",
  "loggingBehavior": "production",
  "android": {
    "backgroundColor": "#D9E4DC",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "hidden": true
    }
  }
}
