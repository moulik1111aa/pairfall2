{
  "name": "pairfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pairfall — a Zen Match–style pair-matching tile game for Android",
  "scripts": {
    "setup:local": "sh scripts/link-tools.sh",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "typescript": "^6.0.3"
  }
}
